# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# dumps de dados de produção (PII/segredos) — nunca versionar
supabase/dump/data.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# grafo de conhecimento gerado localmente (graphify update .) — pesado, não versionar
graphify-out/

# configuração local do Claude Code
.claude/

# scripts temporários de importação/migração pontual
tmp-*.mts

# estado local da CLI do Supabase
supabase/.temp/
