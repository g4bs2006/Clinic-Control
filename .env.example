# Checklist de variáveis. Em dev, copie para .env.local; na VPS, para .env
# (ver deploy/README.md). `./deploy/verificar-env.sh` valida a lista.

# --- Supabase ---------------------------------------------------------------
# Públicas: embutidas no bundle do navegador em tempo de BUILD.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Acesso total ao banco (ignora RLS). Só servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Assina os tokens do realtime das notificações. Sem ela, o sino cai para polling.
SUPABASE_JWT_SECRET=
# Schema onde vivem as tabelas `aniversariantes_*`. Existe só para a migração
# que as tira de `public` (issue #71): deployar com o default, mover as tabelas,
# então definir `aniversariantes` aqui e redeployar. NÃO DEFINIR antes do move —
# o app não acha as tabelas e o painel do Aniversariantes para de carregar.
# Default quando ausente: public
ANIVERSARIANTES_DB_SCHEMA=

# --- Sessão e cifra ---------------------------------------------------------
# Assina o cookie de sessão do auth próprio. Trocar o valor derruba todos os logins.
AUTH_SECRET=
# Cifra/decifra os tokens da Helena guardados no banco. NUNCA regenerar: os
# valores já salvos ficariam ilegíveis.
HELENA_TOKEN_ENC_KEY=
# Chave própria do Cofre. NÃO DEFINIR: produção nunca definiu, então os itens já
# salvos foram cifrados com o fallback (HELENA_TOKEN_ENC_KEY). Preencher agora
# tornaria esses itens ilegíveis. Ver deploy/README.md, passo 1.
VAULT_ENC_KEY=

# --- Integrações ------------------------------------------------------------
# Token da conta MASTER/parceira da Helena (Ajustes > Integrações > Integração via API).
# Necessário para o provisionamento automático de clínicas (criar conta + token).
HELENA_MASTER_TOKEN=
# Mesmo valor do secret CRON_SECRET da Edge Function collect-groups (Supabase
# Dashboard > Edge Functions > collect-groups > Secrets). Permite disparar a
# coleta de grupos da Evolution on-demand pelo botão em /configuracoes, sem
# esperar o cron das 18h.
COLLECT_GROUPS_CRON_SECRET=
# Webhook externo (Google Apps Script / n8n) que cria credenciais de formulário.
# Não está configurada em produção — /api/form-credentials devolve erro hoje.
FORM_WEBHOOK_SECRET=

# --- IA (sugestões de tarefa) ----------------------------------------------
DEEPSEEK_API_KEY=
# Opcionais; defaults: deepseek-chat / https://api.deepseek.com
LLM_MODEL=
LLM_BASE_URL=
